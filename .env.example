# copy to .env and adjust; CLI flags override these values (see: python main.py --help)

# WebSocket JSON-RPC endpoint (required). the default is a free, keyless public endpoint;
# use your own provider for higher rate limits and reliability, for example:
#   wss://eth-mainnet.g.alchemy.com/v2/<api-key>
#   wss://mainnet.infura.io/ws/v3/<project-id>
#   wss://base-rpc.publicnode.com
#   wss://arbitrum-one-rpc.publicnode.com
WS_RPC_URL=wss://ethereum-rpc.publicnode.com

# only stream logs emitted by this contract (optional, comma-separated for several);
# leave empty to stream logs from all contracts, sampled in the feed when busy
CONTRACT_ADDRESS=

# rolling window size in blocks
WINDOW_SIZE=50

# set to false to skip the logs subscription entirely
SUBSCRIBE_LOGS=true

# reconnect when no new block arrives for this many seconds (0 disables)
STALE_TIMEOUT=60

# write connection diagnostics to a file (optional)
LOG_FILE=

# open the desktop GUI instead of the terminal UI (same as --gui)
GUI=false
